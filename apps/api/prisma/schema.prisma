generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

generator zod {
  provider                  = "zod-prisma-types"
  output                    = "../generated/zod"
  createRelationValuesTypes = "true"
  useMultipleFiles          = "true"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum USER_ROLE {
  ADMIN
  USER
}

enum EXAM_STATUS {
  DRAFT
  PUBLISHED
}

enum QUESTION_DIFFICULTY {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum QUALIFICATION_LEVEL {
  BEGINNER
  INTERMEDIATE
  GOOD
  HIGH
  EXPERT
}

model User {
  id                String    @id @default(uuid())
  fullName          String    @map("full_name")
  email             String    @unique
  password          String
  role              USER_ROLE @default(USER)
  phone             String?
  avatar            String?
  locale            String    @default("uz")
  emailVerified     Boolean   @default(false) @map("email_verified")
  passwordChangedAt DateTime? @map("password_changed_at")
  active            Boolean   @default(true)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  examAttempts       ExamAttempt[]
  certificates       Certificate[]
  practiceAttempts   PracticeAttempt[]
  competitionEntries CompetitionEntry[]
  attemptAnalyses    AttemptAnalysis[]

  @@index([email])
  @@map("users")
}

model Specialty {
  id        String   @id @default(uuid())
  name      Json
  imageKey  String?  @map("image_key")
  isActive  Boolean  @default(true) @map("is_active")
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  exams            Exam[]
  topics           Topic[]
  practiceAttempts PracticeAttempt[]
  competitions     Competition[]

  @@map("specialties")
}

model Topic {
  id          String   @id @default(uuid())
  specialtyId String   @map("specialty_id")
  name        Json
  isActive    Boolean  @default(true) @map("is_active")
  order       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  specialty Specialty  @relation(fields: [specialtyId], references: [id], onDelete: Restrict)
  questions Question[]

  @@index([specialtyId, order])
  @@map("topics")
}

model Exam {
  id                  String      @id @default(uuid())
  specialtyId         String      @map("specialty_id")
  title               Json
  description         Json?
  durationMinutes     Int         @map("duration_minutes")
  minCertificateScore Int         @default(0) @map("min_certificate_score")
  status              EXAM_STATUS @default(DRAFT)
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")

  specialty    Specialty     @relation(fields: [specialtyId], references: [id], onDelete: Restrict)
  questions    Question[]
  attempts     ExamAttempt[]
  certificates Certificate[]

  @@index([specialtyId])
  @@index([status])
  @@map("exams")
}

model Question {
  id           String               @id @default(uuid())
  examId       String               @map("exam_id")
  /// Must belong to the same specialty as the exam; null = not yet categorised.
  topicId      String?              @map("topic_id")
  text         Json
  options      Json
  correctIndex Int                  @map("correct_index")
  difficulty   QUESTION_DIFFICULTY
  imageKey     String?              @map("image_key")
  order        Int                  @default(0)
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")

  exam  Exam   @relation(fields: [examId], references: [id], onDelete: Cascade)
  topic Topic? @relation(fields: [topicId], references: [id], onDelete: SetNull)

  @@index([examId, order])
  @@index([topicId])
  @@map("questions")
}

model ExamAttempt {
  id                  String                @id @default(uuid())
  examId              String                @map("exam_id")
  userId              String                @map("user_id")
  minCertificateScore Int                   @map("min_certificate_score")
  questionCount       Int                   @map("question_count")
  answers             Json?
  score               Int?
  correctCount        Int?                  @map("correct_count")
  level               QUALIFICATION_LEVEL?
  timeSpentSeconds    Int?                  @map("time_spent_seconds")
  startedAt           DateTime              @default(now()) @map("started_at")
  submittedAt         DateTime?             @map("submitted_at")

  exam        Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  certificate Certificate?

  @@index([examId, userId])
  @@index([userId])
  @@map("exam_attempts")
}

/// Self-study run over the question bank. Kept apart from ExamAttempt on purpose:
/// practice never feeds ratings, dashboards or certificates.
model PracticeAttempt {
  id               String    @id @default(uuid())
  userId           String    @map("user_id")
  specialtyId      String    @map("specialty_id")
  /// Empty = every topic of the specialty, including untagged questions.
  topicIds         String[]  @map("topic_ids")
  /// Requested mode: AUTO, MIXED or a QUESTION_DIFFICULTY value.
  difficulty       String
  /// Frozen at start, in the order shown to the user.
  questionIds      String[]  @map("question_ids")
  questionCount    Int       @map("question_count")
  answers          Json?
  score            Int?
  correctCount     Int?      @map("correct_count")
  timeSpentSeconds Int?      @map("time_spent_seconds")
  startedAt        DateTime  @default(now()) @map("started_at")
  submittedAt      DateTime? @map("submitted_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialty Specialty @relation(fields: [specialtyId], references: [id], onDelete: Restrict)

  @@index([userId, startedAt])
  @@index([userId, specialtyId])
  @@map("practice_attempts")
}

/// Time-boxed contest: every participant gets the same frozen question set and one entry.
/// Status (upcoming/active/finished) is derived from startsAt/endsAt, never stored.
model Competition {
  id              String   @id @default(uuid())
  specialtyId     String   @map("specialty_id")
  title           Json
  description     Json?
  questionIds     String[] @map("question_ids")
  /// Per-entry time limit; an entry never runs past endsAt either.
  durationMinutes Int      @map("duration_minutes")
  startsAt        DateTime @map("starts_at")
  endsAt          DateTime @map("ends_at")
  /// Set for auto-created weekly contests (e.g. "2026-W43"); with specialtyId it makes creation idempotent.
  weekKey         String?  @map("week_key")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  specialty Specialty          @relation(fields: [specialtyId], references: [id], onDelete: Restrict)
  entries   CompetitionEntry[]

  @@unique([weekKey, specialtyId])
  @@index([startsAt, endsAt])
  @@map("competitions")
}

model CompetitionEntry {
  id               String    @id @default(uuid())
  competitionId    String    @map("competition_id")
  userId           String    @map("user_id")
  answers          Json?
  score            Int?
  correctCount     Int?      @map("correct_count")
  timeSpentSeconds Int?      @map("time_spent_seconds")
  startedAt        DateTime  @default(now()) @map("started_at")
  submittedAt      DateTime? @map("submitted_at")

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// One entry per user per competition.
  @@unique([competitionId, userId])
  @@index([competitionId, score, timeSpentSeconds])
  @@index([userId])
  @@map("competition_entries")
}

enum ANALYSIS_KIND {
  EXAM
  PRACTICE
  COMPETITION
}

/// AI feedback on one finished attempt, generated once per language and reused (each one is a paid API call).
model AttemptAnalysis {
  id           String        @id @default(uuid())
  userId       String        @map("user_id")
  kind         ANALYSIS_KIND
  /// ExamAttempt, PracticeAttempt or CompetitionEntry id, depending on `kind`.
  attemptId    String        @map("attempt_id")
  locale       String
  content      Json
  model        String
  inputTokens  Int           @map("input_tokens")
  outputTokens Int           @map("output_tokens")
  createdAt    DateTime      @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([kind, attemptId, locale])
  @@index([userId, createdAt])
  @@map("attempt_analyses")
}

model RatingSettings {
  id                  String   @id @default(uuid())
  avgScoreWeight      Float    @default(0.4) @map("avg_score_weight")
  bestScoreWeight     Float    @default(0.2) @map("best_score_weight")
  consistencyWeight   Float    @default(0.2) @map("consistency_weight")
  attemptCountWeight  Float    @default(0.2) @map("attempt_count_weight")
  minAttemptsRequired Int      @default(1) @map("min_attempts_required")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("rating_settings")
}

model Certificate {
  id            String               @id @default(uuid())
  certificateId String               @unique @map("certificate_id")
  userId        String               @map("user_id")
  examId        String               @map("exam_id")
  attemptId     String               @unique @map("attempt_id")
  userFullName  String               @map("user_full_name")
  specialtyName Json                 @map("specialty_name")
  score         Int
  level         QUALIFICATION_LEVEL
  issuedAt      DateTime             @default(now()) @map("issued_at")
  expiresAt     DateTime             @map("expires_at")
  revoked       Boolean              @default(false)
  revokedAt     DateTime?            @map("revoked_at")

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam    Exam        @relation(fields: [examId], references: [id], onDelete: Cascade)
  attempt ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([examId])
  @@map("certificates")
}

model CertificateTemplate {
  id        String   @id @default(uuid())
  brand     Json
  title     Json
  subtitle  Json
  bodyText  Json     @map("body_text")
  /// Only an accredited issuer may present certificates as an official qualification document.
  isAccredited      Boolean @default(false) @map("is_accredited")
  accreditationText Json?   @map("accreditation_text")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("certificate_templates")
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String   @map("actor_id")
  actorEmail String   @map("actor_email")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  before     Json?
  after      Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}
