# Copy to `.env` at the repo root before running `docker compose up --build`.
# docker-compose.yml reads this file automatically. Never commit the real `.env`.

# ---- Postgres ----
POSTGRES_USER=app
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=app
POSTGRES_PORT=5432

# ---- Redis ----
REDIS_PORT=6379

# ---- API ----
API_PORT=9100
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=1d

# Public URLs the browser will actually use — update for a real deployment.
WEB_URL=http://localhost:3001
PUBLIC_URL=http://localhost:9100
CORS_ORIGIN=http://localhost:3001

SWAGGER_ENABLED=true
SWAGGER_PATH=/docs

# S3 file storage — leave empty to fall back to local disk storage (fine for dev/testing).
AWS_REGION=eu-central-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_FILE_VIEW_EXPIRY=3600

MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=App <no-reply@example.com>

# Seeded once on first container start (seed.ts upserts — safe to leave set on restarts)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change_me_strong_password

# ---- Web ----
WEB_PORT=3001
# Must be reachable from the END USER's BROWSER (not the Docker-internal network) —
# NEXT_PUBLIC_API_URL is baked into the client bundle at build time.
NEXT_PUBLIC_API_URL=http://localhost:9100/api
