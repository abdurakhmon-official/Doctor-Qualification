# Production settings for the VPS. On the server:
#   cp deploy/env.production.sample .env   # then fill in every "change_me" and domain
# Never commit the real .env.

# ---- Domains (DNS A records of both must point at this server before the first start) ----
WEB_DOMAIN=doctor.example.uz
API_DOMAIN=api.doctor.example.uz
# Let's Encrypt sends certificate expiry notices here
ACME_EMAIL=admin@example.uz

# ---- Postgres ----
POSTGRES_USER=app
# generate: openssl rand -hex 24
POSTGRES_PASSWORD=change_me
POSTGRES_DB=app

# ---- API ----
# generate: openssl rand -hex 48
JWT_SECRET=change_me
JWT_EXPIRES_IN=1d

# must match the domains above (https, no trailing slash)
WEB_URL=https://doctor.example.uz
CORS_ORIGIN=https://doctor.example.uz
PUBLIC_URL=https://api.doctor.example.uz
# baked into the web app at build time - rebuild the web image after changing it
NEXT_PUBLIC_API_URL=https://api.doctor.example.uz/api/v1

SWAGGER_ENABLED=false
SWAGGER_PATH=/docs

# Files: leave the S3 values empty to keep uploads on the server's disk (the api_storage volume, included in
# docker-compose.prod.yml). Fill them in only if you prefer AWS S3.
AWS_REGION=eu-central-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_FILE_VIEW_EXPIRY=3600

# Mail (password reset / verification) - any SMTP provider
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=Doctor Qualification <no-reply@example.uz>

# AI tutor (Claude). Empty key = assistant switched off.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_DAILY_LIMIT=10
AI_REVEAL_CORRECT_ANSWERS=false

# Created on the first start (upsert - changing the password here later does not change it)
SEED_ADMIN_EMAIL=admin@example.uz
SEED_ADMIN_PASSWORD=change_me

# Nightly database dumps in ./backups, kept this many days
BACKUP_KEEP_DAYS=14
